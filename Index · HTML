<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ping — AI Visibility Scanner</title>
<meta name="description" content="Ping asks AI assistants the questions your buyers already ask, then measures whether your brand shows up.">

<!--
  BRAND NAME: "Ping" is a placeholder. It appears as a literal string
  throughout this file — find & replace "Ping" if you want a different name.

  PRICING: the dollar figures below are placeholders. Search for
  "EDIT PRICE" to find every spot that needs a real number before this
  goes live.

  TESTIMONIALS: intentionally left out. Add real client quotes once you
  have them — do not fill this with invented reviews.
-->

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
  :root {
    --bg: #0B0E11;
    --bg-raised: #12161B;
    --bg-raised-2: #171C22;
    --text: #EDEEF0;
    --text-dim: #8B94A0;
    --text-faint: #565F6C;
    --signal: #FFB300;
    --signal-dim: rgba(255, 179, 0, 0.14);
    --no-signal: #3A4250;
    --border: #232830;
    --danger: #E5695C;
    --radius: 10px;
    --display: "Space Grotesk", sans-serif;
    --body: "IBM Plex Sans", sans-serif;
    --mono: "IBM Plex Mono", monospace;
  }

  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }

  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font-family: var(--body);
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }

  img, svg { display: block; max-width: 100%; }

  a { color: inherit; }

  h1, h2, h3 {
    font-family: var(--display);
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }

  p { margin: 0; }

  .eyebrow {
    font-family: var(--mono);
    font-size: 12.5px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--signal);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .eyebrow::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 3px var(--signal-dim);
    flex: none;
  }

  .wrap {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 28px;
  }

  section { padding: 108px 0; border-bottom: 1px solid var(--border); }

  button, input, select, textarea { font-family: inherit; }

  :focus-visible {
    outline: 2px solid var(--signal);
    outline-offset: 3px;
  }

  /* ---------- Nav ---------- */
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 14, 17, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .nav {
    max-width: 1120px;
    margin: 0 auto;
    padding: 18px 28px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .wordmark {
    font-family: var(--display);
    font-weight: 700;
    font-size: 20px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .wordmark .dot {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px var(--signal-dim);
  }
  .nav-links {
    display: flex;
    gap: 32px;
    list-style: none;
    margin: 0; padding: 0;
    font-size: 14.5px;
    color: var(--text-dim);
  }
  .nav-links a { text-decoration: none; }
  .nav-links a:hover { color: var(--text); }
  .nav-cta {
    display: inline-flex;
  }
  .navlist-mobile { display: none; }

  /* ---------- Buttons ---------- */
  .btn {
    font-family: var(--mono);
    font-size: 13.5px;
    letter-spacing: 0.02em;
    border-radius: 7px;
    padding: 12px 20px;
    border: 1px solid transparent;
    cursor: pointer;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: transform 0.12s ease, background 0.12s ease, border-color .12s ease;
  }
  .btn:active { transform: translateY(1px); }
  .btn-signal { background: var(--signal); color: #171200; font-weight: 500; }
  .btn-signal:hover { background: #FFC233; }
  .btn-ghost { background: transparent; color: var(--text); border-color: var(--border); }
  .btn-ghost:hover { border-color: var(--text-faint); }
  .btn:disabled { opacity: 0.5; cursor: not-allowed; }

  /* ---------- Hero ---------- */
  .hero { padding-top: 96px; padding-bottom: 88px; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 64px;
    align-items: center;
  }
  .hero h1 {
    font-size: 50px;
    line-height: 1.08;
    margin: 22px 0 22px;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--signal);
  }
  .hero p.lede {
    font-size: 17.5px;
    color: var(--text-dim);
    max-width: 46ch;
  }
  .hero-ctas {
    display: flex;
    gap: 14px;
    align-items: center;
    margin-top: 32px;
  }
  .hero-ctas .link {
    font-size: 14px;
    color: var(--text-dim);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }
  .hero-ctas .link:hover { color: var(--text); border-color: var(--text-faint); }

  /* Signal readout panel (decorative, hero) */
  .scope {
    background: var(--bg-raised);
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 22px;
  }
  .scope-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 18px;
  }
  .scope-row {
    display: grid;
    grid-template-columns: 20px 1fr 60px;
    align-items: center;
    gap: 14px;
    padding: 11px 4px;
    border-bottom: 1px dashed var(--border);
    font-family: var(--mono);
    font-size: 13px;
    color: var(--text-dim);
  }
  .scope-row:last-child { border-bottom: none; }
  .blip {
    width: 9px; height: 9px; border-radius: 50%;
    background: var(--no-signal);
  }
  .scope-row.hit .blip {
    background: var(--signal);
    box-shadow: 0 0 0 4px var(--signal-dim);
    animation: pulse 2.2s ease-in-out infinite;
  }
  .scope-row.hit { color: var(--text); }
  .scope-tag {
    text-align: right;
    font-size: 11px;
    color: var(--text-faint);
  }
  .scope-row.hit .scope-tag { color: var(--signal); }
  @keyframes pulse {
    0%, 100% { box-shadow: 0 0 0 4px var(--signal-dim); }
    50% { box-shadow: 0 0 0 8px transparent; }
  }

  /* ---------- Section heads ---------- */
  .section-head { max-width: 640px; margin-bottom: 52px; }
  .section-head h2 { font-size: 34px; margin-top: 16px; }
  .section-head p { color: var(--text-dim); margin-top: 14px; font-size: 15.5px; }

  /* ---------- Live demo ---------- */
  #demo { background: var(--bg-raised); }
  .demo-shell {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 0;
    border: 1px solid var(--border);
    border-radius: 14px;
    overflow: hidden;
    background: var(--bg);
  }
  .demo-form {
    padding: 32px;
    border-right: 1px solid var(--border);
  }
  .field { margin-bottom: 18px; }
  .field label {
    display: block;
    font-family: var(--mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-faint);
    margin-bottom: 8px;
  }
  .field input {
    width: 100%;
    background: var(--bg-raised-2);
    border: 1px solid var(--border);
    border-radius: 7px;
    padding: 11px 12px;
    color: var(--text);
    font-size: 14.5px;
  }
  .field input::placeholder { color: var(--text-faint); }
  .field input:focus { border-color: var(--signal); }
  .field small { display: block; margin-top: 6px; color: var(--text-faint); font-size: 12px; }
  .demo-form .btn { width: 100%; justify-content: center; margin-top: 6px; }
  .demo-disclaimer {
    font-size: 12px;
    color: var(--text-faint);
    margin-top: 16px;
    line-height: 1.5;
  }

  .demo-output {
    padding: 32px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 380px;
  }
  .demo-idle { color: var(--text-faint); font-family: var(--mono); font-size: 13.5px; }
  .demo-idle .arrow { color: var(--signal); }

  .demo-loading { font-family: var(--mono); font-size: 13.5px; color: var(--text-dim); }
  .demo-loading .scanline {
    height: 2px; background: linear-gradient(90deg, transparent, var(--signal), transparent);
    margin: 18px 0 22px; animation: scan 1.6s ease-in-out infinite;
  }
  @keyframes scan { 0% { opacity: 0.25 } 50% { opacity: 1 } 100% { opacity: 0.25 } }
  .demo-loading .caption { min-height: 20px; }
  .demo-loading .note { color: var(--text-faint); font-size: 12px; margin-top: 14px; }

  .demo-error {
    font-family: var(--mono);
    font-size: 13.5px;
    color: var(--danger);
    border: 1px solid rgba(229,105,92,0.35);
    background: rgba(229,105,92,0.08);
    border-radius: 8px;
    padding: 16px;
  }

  .score-row {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-bottom: 26px;
  }
  .score-ring { flex: none; }
  .score-num { font-family: var(--display); font-size: 26px; fill: var(--text); }
  .score-label { font-family: var(--mono); font-size: 11px; fill: var(--text-faint); }
  .score-verdict h3 { font-size: 19px; margin-bottom: 4px; }
  .score-verdict p { color: var(--text-dim); font-size: 13.5px; }

  .demo-section-label {
    font-family: var(--mono);
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
    margin: 22px 0 10px;
  }

  .result-row {
    display: grid;
    grid-template-columns: 16px 1fr auto;
    gap: 12px;
    align-items: center;
    padding: 9px 0;
    border-bottom: 1px dashed var(--border);
    font-size: 13.5px;
  }
  .result-row:last-child { border-bottom: none; }
  .result-row .blip { width: 8px; height: 8px; }
  .result-row.hit .blip { background: var(--signal); }
  .result-row .prompt-text { color: var(--text-dim); }
  .result-row.hit .prompt-text { color: var(--text); }
  .result-row .pos { font-family: var(--mono); font-size: 11.5px; color: var(--text-faint); }

  .cov-row { margin-bottom: 10px; }
  .cov-top { display: flex; justify-content: space-between; font-size: 12.5px; margin-bottom: 5px; color: var(--text-dim); }
  .cov-bar-track { height: 6px; background: var(--bg-raised-2); border-radius: 4px; overflow: hidden; }
  .cov-bar-fill { height: 100%; background: var(--no-signal); border-radius: 4px; }

  .rec-list { margin: 0; padding-left: 20px; color: var(--text-dim); font-size: 13.5px; }
  .rec-list li { margin-bottom: 8px; }

  /* ---------- How it works ---------- */
  .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; }
  .step { padding: 26px; border: 1px solid var(--border); border-radius: 12px; background: var(--bg-raised); }
  .step .num { font-family: var(--mono); color: var(--signal); font-size: 12.5px; }
  .step h3 { font-size: 18px; margin: 14px 0 10px; }
  .step p { color: var(--text-dim); font-size: 14px; }

  /* ---------- Why it matters ---------- */
  .matters { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: start; }
  .matters h2 { font-size: 32px; }
  .matters .body p { color: var(--text-dim); font-size: 16px; margin-bottom: 16px; }
  .matters .body p:last-child { margin-bottom: 0; }

  /* ---------- Pricing ---------- */
  .plans { display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; align-items: stretch; }
  .plan {
    border: 1px solid var(--border);
    border-radius: 14px;
    padding: 30px 26px;
    background: var(--bg-raised);
    display: flex;
    flex-direction: column;
  }
  .plan.featured { border-color: var(--signal); background: linear-gradient(180deg, rgba(255,179,0,0.05), transparent 40%), var(--bg-raised); }
  .plan-name { font-family: var(--mono); font-size: 12px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-faint); }
  .plan.featured .plan-name { color: var(--signal); }
  .plan-price { font-family: var(--display); font-size: 34px; margin: 12px 0 4px; }
  .plan-price span { font-family: var(--mono); font-size: 13px; color: var(--text-faint); font-weight: 400; }
  .plan-desc { color: var(--text-dim); font-size: 13.5px; margin-bottom: 20px; }
  .plan-features { list-style: none; margin: 0 0 24px; padding: 0; flex: 1; }
  .plan-features li {
    font-size: 13.5px; color: var(--text-dim);
    padding: 9px 0; border-top: 1px dashed var(--border);
    display: flex; gap: 10px;
  }
  .plan-features li:first-child { border-top: none; }
  .plan-features li::before { content: "—"; color: var(--text-faint); flex: none; }
  .plan .btn { width: 100%; justify-content: center; }

  /* ---------- FAQ ---------- */
  .faq-list { max-width: 760px; }
  .faq-item { border-top: 1px solid var(--border); padding: 24px 0; }
  .faq-item:last-child { border-bottom: 1px solid var(--border); }
  .faq-item h3 { font-size: 16.5px; font-weight: 600; margin-bottom: 10px; }
  .faq-item p { color: var(--text-dim); font-size: 14.5px; }

  /* ---------- Footer ---------- */
  footer { padding: 56px 0 40px; }
  .foot-row {
    display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 24px;
  }
  .foot-links { display: flex; gap: 26px; list-style: none; padding: 0; margin: 0; font-size: 13.5px; color: var(--text-dim); }
  .foot-links a { text-decoration: none; }
  .foot-links a:hover { color: var(--text); }
  .foot-fine { color: var(--text-faint); font-size: 12.5px; margin-top: 28px; }

  /* ---------- Responsive ---------- */
  @media (max-width: 880px) {
    section { padding: 72px 0; }
    .hero-grid { grid-template-columns: 1fr; gap: 44px; }
    .hero h1 { font-size: 36px; }
    .nav-links { display: none; }
    .demo-shell { grid-template-columns: 1fr; }
    .demo-form { border-right: none; border-bottom: 1px solid var(--border); }
    .steps { grid-template-columns: 1fr; }
    .matters { grid-template-columns: 1fr; gap: 28px; }
    .plans { grid-template-columns: 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    * { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; transition-duration: 0.001ms !important; }
    html { scroll-behavior: auto; }
  }
</style>
</head>
