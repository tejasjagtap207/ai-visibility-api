<script>
(function () {
  const form = document.getElementById('demo-form');
  const output = document.getElementById('demo-output');
  const submitBtn = document.getElementById('demo-submit');

  function promptsFor(industry) {
    return [
      `What are the best ${industry} in 2026?`,
      `Top ${industry} for small businesses`,
      `${industry} recommendations`,
      `Compare the leading ${industry} options`,
      `Which ${industry} should I choose and why?`
    ];
  }

  function escapeHtml(str) {
    return String(str)
      .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;');
  }

  function renderLoading(industry) {
    const prompts = promptsFor(industry);
    output.innerHTML = `
      <div class="demo-loading">
        <p class="eyebrow" style="margin-bottom:14px;">Scanning</p>
        <div class="scanline"></div>
        <p class="caption" id="loading-caption">Asking: "${escapeHtml(prompts[0])}"</p>
        <p class="note">This usually takes 15–30 seconds — Ping is asking AI five real questions and analyzing each answer.</p>
      </div>`;
    let i = 0;
    return setInterval(() => {
      i = (i + 1) % prompts.length;
      const cap = document.getElementById('loading-caption');
      if (cap) cap.textContent = `Asking: "${prompts[i]}"`;
    }, 2800);
  }

  function verdictFor(score) {
    if (score >= 60) return ['Strongly visible', 'Your brand shows up consistently across buyer questions.'];
    if (score >= 20) return ['Partially visible', 'Your brand appears sometimes, but not reliably.'];
    return ['Not visible', 'AI assistants aren\u2019t naming your brand for these questions yet.'];
  }

  function renderScoreRing(score) {
    const r = 34, c = 2 * Math.PI * r;
    const offset = c - (score / 100) * c;
    return `
      <svg class="score-ring" width="88" height="88" viewBox="0 0 88 88">
        <circle cx="44" cy="44" r="${r}" fill="none" stroke="#232830" stroke-width="8"/>
        <circle cx="44" cy="44" r="${r}" fill="none" stroke="#FFB300" stroke-width="8"
          stroke-linecap="round" stroke-dasharray="${c}" stroke-dashoffset="${offset}"
          transform="rotate(-90 44 44)"/>
        <text x="44" y="41" text-anchor="middle" class="score-num">${score}</text>
        <text x="44" y="58" text-anchor="middle" class="score-label">/ 100</text>
      </svg>`;
  }

  function renderResult(data) {
    const report = data.visibility_report;
    const [verdictTitle, verdictBody] = verdictFor(report.visibility_score);

    const rows = report.mentions.map(m => `
      <div class="result-row ${m.brand_mentioned ? 'hit' : ''}">
        <span class="blip"></span>
        <span class="prompt-text">${escapeHtml(m.prompt)}</span>
        <span class="pos">${m.brand_mentioned ? (m.position ? '#' + m.position : 'mentioned') : '—'}</span>
      </div>`).join('');

    const maxMentions = Math.max(1, ...report.competitor_share_of_voice.map(c => c.mention_count));
    const coverage = report.competitor_share_of_voice.length
      ? report.competitor_share_of_voice.map(c => `
        <div class="cov-row">
          <div class="cov-top"><span>${escapeHtml(c.competitor_name)}</span><span>${c.mention_count}/5</span></div>
          <div class="cov-bar-track"><div class="cov-bar-fill" style="width:${(c.mention_count / maxMentions) * 100}%"></div></div>
        </div>`).join('')
      : `<p style="color:var(--text-faint); font-size:13px;">No named competitors appeared in these answers.</p>`;

    const recs = report.improvement_recommendations.map(r => `<li>${escapeHtml(r)}</li>`).join('');

    output.innerHTML = `
      <div class="score-row">
        ${renderScoreRing(report.visibility_score)}
        <div class="score-verdict">
          <h3>${verdictTitle}</h3>
          <p>${verdictBody}</p>
        </div>
      </div>
      <p class="demo-section-label">Per-question signal</p>
      <div>${rows}</div>
      <p class="demo-section-label">Competitor share of voice</p>
      <div>${coverage}</div>
      <p class="demo-section-label">Improve your score</p>
      <ol class="rec-list">${recs}</ol>
    `;
  }

  function renderError(status) {
    let msg;
    if (status === 403) {
      msg = 'Free scans are all used up for now. Get full API access below to keep scanning without limits.';
    } else if (status === 401) {
      msg = 'That scan didn\u2019t go through on our end. Refresh the page and try again.';
    } else if (status === 400) {
      msg = 'Add both a brand name and an industry, then try again.';
    } else {
      msg = 'Something broke on our end running that scan. Try again in a moment.';
    }
    output.innerHTML = `<div class="demo-error">${msg}</div>`;
  }

  form.addEventListener('submit', async function (e) {
    e.preventDefault();
    const brand_name = document.getElementById('brand_name').value.trim();
    const industry = document.getElementById('industry').value.trim();
    const competitors = document.getElementById('competitors').value
      .split(',').map(s => s.trim()).filter(Boolean).slice(0, 3);

    if (!brand_name || !industry) return;

    submitBtn.disabled = true;
    submitBtn.textContent = 'Scanning…';
    const captionTimer = renderLoading(industry);

    try {
      const res = await fetch('/api/demo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ brand_name, industry, competitors })
      });
      clearInterval(captionTimer);
      const data = await res.json().catch(() => ({}));
      if (res.ok && data.success) {
        renderResult(data);
      } else {
        renderError(res.status);
      }
    } catch (err) {
      clearInterval(captionTimer);
      renderError(0);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = 'Scan now';
    }
  });
})();
</script>

</body>
